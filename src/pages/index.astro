---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';

const profilePath = new URL('../../public/images/profile.jpg', import.meta.url);
const hasProfile = existsSync(profilePath);
---

<BaseLayout title="Sergi Romero — Portfolio">
  <main>
    <section class="hero">
      <div class="hero__media">
        {
          hasProfile ? (
            <img
              src="/images/profile.jpg"
              alt="Portrait of Sergi Romero"
              width="180"
              height="180"
              loading="eager"
              decoding="async"
              class="hero__photo"
            />
          ) : (
            <div class="hero__photo hero__photo--placeholder" aria-hidden="true">
              <span>SR</span>
            </div>
          )
        }
      </div>
      <h1>Sergi Romero</h1>
      <p class="tagline">[Professional tagline]</p>
      <p class="intro">[Short introduction]</p>
    </section>

    <section class="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects</h2>
      <p class="placeholder-note">Projects coming soon.</p>
    </section>
  </main>
</BaseLayout>