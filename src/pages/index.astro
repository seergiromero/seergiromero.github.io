---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const profilePath = new URL('../../public/images/profile.webp', import.meta.url);
const hasProfile = existsSync(profilePath);

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout title="Sergi Romero — Portfolio">
  <main>
    <section class="hero">
      <div class="hero__media">
        {
          hasProfile ? (
            <img
              src="/images/profile.webp"
              alt="Portrait of Sergi Romero"
              width="180"
              height="180"
              loading="eager"
              decoding="async"
              class="hero__photo"
            />
          ) : (
            <div class="hero__photo hero__photo--placeholder" aria-hidden="true">
              <span>SR</span>
            </div>
          )
        }
      </div>
      <h1>Sergi Romero</h1>
      <p class="tagline">Robotics and Automatic Control Engineer</p>
      <p class="intro">
        M.Sc. in Robotics and Automatic Control from UPC (ETSEIB), with a
        background in Industrial Electronics and Automation. I've worked 
        across the robotics stack — from servicing and diagnosing autonomous 
        mobile robots at Mobile Industrial Robots (MiR), to writing 
        open-source ROS2 software for Universal Robots' cobot ecosystem.
        I care about the engineering behind robots, and I'm driven to build 
        and contribute to real-world robotics and AI projects.
      </p>
    </section>

    <section class="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects</h2>
      <div class="project-grid">
        {featuredProjects.map((project, i) => (
          <ProjectCard project={project} index={i + 1} variant="compact" />
        ))}
      </div>
      <p>
        <a href="/projects/">View all projects</a>
      </p>
    </section>
  </main>
</BaseLayout>